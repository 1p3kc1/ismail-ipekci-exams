@using MVC_GymMembers.Models.Entities
@model List<Member>

@{
    ViewData["Title"] = "Spor Salonu Üyeleri";
}

<div class="container mt-4">

    <h1 class="mb-4">
        Salonumuzda @Model.Count üye var
    </h1>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Ad Soyad</th>
                <th>Üyelik Tipi</th>
                <th>Yaş</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var member in Model)
            {
                <tr>
                    <td>@member.Id</td>
                    <td>@member.FullName</td>
                    <td>@member.MembershipType</td>
                    <td>@member.Age</td>
                </tr>
            }
        </tbody>
    </table>

</div>
@using MVC_MovieArchive.Models.Entities
@model List<Movie>

@{
    ViewData["Title"] = "Film Arşivi";
}

<div class="container mt-4">

    <h1 class="mb-4">
        Arşivimizde @Model.Count film var
    </h1>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Film Adı</th>
                <th>Yönetmen</th>
                <th>Vizyon Yılı</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Id</td>
                    <td>@movie.Title</td>
                    <td>@movie.Director</td>
                    <td>@movie.ReleaseYear</td>
                </tr>
            }
        </tbody>
    </table>

</div>
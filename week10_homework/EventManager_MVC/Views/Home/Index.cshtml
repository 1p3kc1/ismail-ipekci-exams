
@{
    ViewData["Title"] = "Ana Sayfa";
}



<section class="events-section" id="events">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-small-title">ETKİNLİK PAKETLERİ</span>

            <h2 class="section-title">
                Hayalindeki Etkinliği Seç
            </h2>

            <p class="section-text">
                Her özel an için ihtiyaçlarınıza uygun profesyonel
                etkinlik çözümleri sunuyoruz.
            </p>
        </div>

        <div class="row g-4">

            <!-- Düğün -->
            <div class="col-lg-3 col-md-6">
                <div class="card event-card h-100">

                    <img src="https://www.weddingunicorn.com/_next/image?url=%2Fblog-images%2Fwestchester-wedding-venues-guide-2026.jpg&w=1080&q=75&dpl=dpl_3AY5orpaB1UjFi2YUWExndaouRNR"
                         class="card-img-top"
                         alt="Düğün organizasyonu">

                    <div class="card-body">
                        <h5 class="card-title">Düğün</h5>

                        <p class="card-text">
                            Hayalinizdeki düğünü tüm detaylarıyla
                            profesyonel ekibimizle planlayın.
                        </p>

                        <div class="event-price">
                            15.000 TL'den başlayan fiyatlarla
                        </div>
                    </div>

                </div>
            </div>


            <!-- Kurumsal Konferans -->
            <div class="col-lg-3 col-md-6">
                <div class="card event-card h-100">

                    <img src="https://epnext.com/wp-content/uploads/2023/05/kurumsal_girisim_sermayesi_konf.jpg"
                         class="card-img-top"
                         alt="Kurumsal konferans">

                    <div class="card-body">
                        <h5 class="card-title">Kurumsal Konferans</h5>

                        <p class="card-text">
                            Toplantı, seminer ve konferanslarınızı
                            profesyonel bir deneyime dönüştürün.
                        </p>

                        <div class="event-price">
                            12.000 TL'den başlayan fiyatlarla
                        </div>
                    </div>

                </div>
            </div>


            <!-- Doğum Günü -->
            <div class="col-lg-3 col-md-6">
                <div class="card event-card h-100">

                    <img src="https://vivaeventss.com.au/image/genderR.png"
                         class="card-img-top"
                         alt="Doğum günü organizasyonu">

                    <div class="card-body">
                        <h5 class="card-title">Doğum Günü</h5>

                        <p class="card-text">
                            Her yaşa özel eğlenceli ve unutulmaz
                            doğum günü organizasyonları.
                        </p>

                        <div class="event-price">
                            5.000 TL'den başlayan fiyatlarla
                        </div>
                    </div>

                </div>
            </div>


            <!-- Nişan -->
            <div class="col-lg-3 col-md-6">
                <div class="card event-card h-100">

                    <img src="https://vivaeventss.com.au/image/outdoor-engagement-setup.png"
                         class="card-img-top"
                         alt="Nişan organizasyonu">

                    <div class="card-body">
                        <h5 class="card-title">Nişan</h5>

                        <p class="card-text">
                            En özel başlangıcınızı şık ve
                            unutulmaz bir organizasyonla kutlayın.
                        </p>

                        <div class="event-price">
                            8.000 TL'den başlayan fiyatlarla
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

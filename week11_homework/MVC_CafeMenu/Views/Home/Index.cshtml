@using MVC_CafeMenu.Models.Entities
@model List<MenuItem>

@{
    ViewData["Title"] = "Kafe Menüsü";
}

<div class="container mt-4">

    <h1 class="mb-4">
        Menümüzde @Model.Count ürün var
    </h1>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Ürün Adı</th>
                <th>Kategori</th>
                <th>Fiyat</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Price TL</td>
                </tr>
            }
        </tbody>
    </table>

</div>